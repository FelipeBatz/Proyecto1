digraph AFD {
	rankdir=LR;
    	bgcolor="white"; 
    	node [fontname="Helvetica", fontcolor="#ffffff", style="filled", fillcolor="#2d3748", color="#4a5568", penwidth=2];
    	edge [fontname="Helvetica", fontcolor="black", color="#cbd5e0", penwidth=1.5];
    	node [shape = point, fillcolor="#ffffff", width=0.15] start;
    	node [shape = doublecircle, fillcolor="#1c4ed8", color="#60a5fa", fontcolor="#ffffff"] q1 q2 q4 q8 q9 q11 q12 q14;
    	node [shape = circle, fillcolor="#374151", color="#9ca3af"] q0 q3 q5 q6 q7 q10 q13;
    	start -> q0 [color="#38bdf8"];

	//Identificadores, directivas, comandos de IA, conectectores, Funciones, Palabras reservadas
	q0 -> q1 [label=" Letra \n @ \n _"];
	q1 -> q1 [label=" Letra \n @ \n _ "];

	// operadores y delimitadores
	q0 -> q2 [label="( | ) | { | }  \n + | ="];

	//Cadenas de texto
	q0 -> q3 [label=" \" "];
	q3 -> q3 [label=" Letra \n Digito \n @ | - | > | _ | / | * \n + | = \n ( | ) | { | } \n \\s "];
	q3 -> q4 [label=" \" "];

	//Comentarios
	q0 -> q5 [label=" / "];
    	q5 -> q6 [label="*"];
	q6 -> q6 [label=" Letra \n Digito \n @ | - | > | _ | /  \n + | = \n ( | ) | { | } \n \\s  "];
	q6 -> q7 [label="*"];
	q7 -> q8 [label="/"];

	q5 -> q9 [label="/"];
	q9 -> q9 [label=" Letra \n Digito \n @ | - | > | _ | / | * \n + | = \n ( | ) | { | } \n \\s "];
    	
    	//Conector ->
	q0 -> q10 [label=" - "];
	q10 -> q11 [label=" > "];


    	//Numeros enteros y decimales
    	q0 -> q12 [label=" Digito "];
	q12 -> q12 [label=" Digito "];
	q12 -> q13 [label=" . "];
	q13 -> q14 [label=" Digito "];
	q14 -> q14 [label=" Digito "];
    	
}