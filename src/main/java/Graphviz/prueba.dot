digraph AFD {
	rankdir=LR;
    	bgcolor="#1e1e1e"; // Fondo oscuro para resaltar los colores
    	node [fontname="Helvetica", fontcolor="#ffffff", style="filled", fillcolor="#2d3748", color="#4a5568", penwidth=2];
    	edge [fontname="Helvetica", fontcolor="#e2e8f0", color="#cbd5e0", penwidth=1.5];
    	node [shape = point, fillcolor="#ffffff", width=0.15] start;
    	node [shape = doublecircle, fillcolor="#1c4ed8", color="#60a5fa", fontcolor="#ffffff"] q1 q2 q4 q8 q9 q11 q12 q14;
    	node [shape = circle, fillcolor="#374151", color="#9ca3af"] q0 q3 q5 q6 q7 q10 q13;
    	start -> q0 [color="#38bdf8"];

	// Transiciones desde q0
    	q0 -> q1 [label=" _ \n [a-z] \n @ "];
    	q0 -> q2 [label="( | ) | { | } | \"\n+ | ="];
    	q0 -> q3 [label="\""];
    	q0 -> q5 [label="/"];
    	q0 -> q10 [label="-"];
    	q0 -> q12 [label="[0-9]"];

    	// bucles
    	q1 -> q1 [label="[0-9]\n_\n[a-z]"];

    	q3 -> q3 [label="[0-9]\n+ | =\n[a-z]\n@ | - | > | _ | / | \n ( | ) | { | } | \ *"];
    	q3 -> q4 [label="\""];
	
    	q5 -> q6 [label="*"];
    	q5 -> q9 [label="/"];

   	q6 -> q6 [label="[a-z]\n[0-9]\n+ | =\n( | ) | { | } | \"\n@ | - | > | _ | / | *"];
    	q6 -> q7 [label="*"];

    	q7 -> q8 [label="/"];

    	q9 -> q9 [label="[a-z]\n[0-9]\n+ | =\n( | ) | { | } | \"\n@ | - | > | _ | / | *"];

    	q10 -> q11 [label=">"];

    	q12 -> q12 [label="[0-9]"];
    	q12 -> q13 [label="."];

    	q13 -> q14 [label="[0-9]"];

    	q14 -> q14 [label="[0-9]"];
}